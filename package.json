{
  "name": "@rio-cloud/react-datetime",
  "version": "3.2.0",
  "description": "A fork of the lightweight but complete datetime picker React.js component",
  "homepage": "https://github.com/rio-cloud/react-datetime",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rio-cloud/react-datetime.git"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/react-datetime.cjs.js",
  "module": "./dist/react-datetime.esm.mjs",
  "typings": "./typings/DateTime.d.ts",
  "exports": {
    ".": {
      "types": "./typings/DateTime.d.ts",
      "import": "./dist/react-datetime.esm.mjs",
      "require": "./dist/react-datetime.cjs.js",
      "default": "./dist/react-datetime.esm.mjs"
    },
    "./css/*": "./css/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "css",
    "dist",
    "typings/DateTime.d.ts"
  ],
  "scripts": {
    "build": "vite build --config vite.build.config.mjs --mode es && vite build --config vite.build.config.mjs --mode cjs && vite build --config vite.build.config.mjs --mode umd",
    "lint": "eslint src/DateTime.js test/ && echo 'Linting OK! 💪'",
    "notify-pre-commit-hook": "echo '### Starting pre-commit hook 🦄'",
    "playground": "node scripts/start.js",
    "prepack": "npm run test:all && npm run lint && npm run build && npm run test:dist",
    "test": "vitest run",
    "test:dist": "node scripts/test-dist.js",
    "test:typings": "tsc -p ./typings",
    "test:all": "echo 'Running tests...' && npm run test:typings && npm run test && echo 'All tests passed! 🤘'",
    "test:watch": "vitest"
  },
  "keywords": [
    "react",
    "react-component",
    "datepicker",
    "timepicker",
    "datetimepicker",
    "datetime"
  ],
  "author": "Javier Marquez",
  "license": "MIT",
  "peerDependencies": {
    "moment": "^2.16.0",
    "react": "^16.14.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "7.7.4",
    "@babel/plugin-proposal-class-properties": "^7.7.4",
    "@babel/preset-env": "^7.7.7",
    "@babel/preset-react": "^7.7.4",
    "@svgr/webpack": "4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^2.8.0",
    "@typescript-eslint/parser": "^2.8.0",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-eslint": "10.0.3",
    "babel-loader": "8.0.6",
    "babel-plugin-named-asset-import": "^0.3.5",
    "camelcase": "^5.3.1",
    "case-sensitive-paths-webpack-plugin": "2.2.0",
    "css-loader": "3.2.0",
    "dotenv": "8.2.0",
    "dotenv-expand": "5.1.0",
    "eslint": "^6.6.0",
    "eslint-config-react-app": "^5.1.0",
    "eslint-loader": "3.0.2",
    "eslint-plugin-flowtype": "3.13.0",
    "eslint-plugin-import": "2.18.2",
    "eslint-plugin-jsx-a11y": "6.2.3",
    "eslint-plugin-react": "7.16.0",
    "eslint-plugin-react-hooks": "^1.6.1",
    "file-loader": "4.3.0",
    "fs-extra": "^8.1.0",
    "html-webpack-plugin": "4.0.0-beta.5",
    "jsdom": "^26.0.0",
    "mini-css-extract-plugin": "0.8.0",
    "moment": "^2.16.0",
    "moment-timezone": "^0.5.13",
    "optimize-css-assets-webpack-plugin": "5.0.3",
    "pnp-webpack-plugin": "1.5.0",
    "postcss-flexbugs-fixes": "4.1.0",
    "postcss-loader": "3.0.0",
    "postcss-normalize": "8.0.1",
    "postcss-preset-env": "6.7.0",
    "postcss-safe-parser": "4.0.1",
    "pre-commit": "^1.1.3",
    "react": "^18.3.1",
    "react-app-polyfill": "^1.0.5",
    "react-dev-utils": "10.1.0",
    "react-dom": "^18.3.1",
    "resolve": "1.12.2",
    "resolve-url-loader": "3.1.1",
    "sass-loader": "8.0.0",
    "semver": "6.3.0",
    "style-loader": "1.0.0",
    "terser-webpack-plugin": "4.2.1",
    "through2": "^2.0.3",
    "ts-pnp": "1.1.5",
    "typescript": "^5.7.3",
    "url-loader": "2.3.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "webpack": "4.41.2",
    "webpack-cli": "^3.3.10",
    "webpack-dev-server": "3.11.0",
    "webpack-manifest-plugin": "2.2.0",
    "workbox-webpack-plugin": "4.3.1"
  },
  "dependencies": {
    "prop-types": "^15.5.7"
  },
  "pre-commit": [
    "notify-pre-commit-hook",
    "lint",
    "test:all"
  ],
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
